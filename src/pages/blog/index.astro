---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import FormattedDate from "@/components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog" description="My personal blog">
    <div class="min-h-[90vh]">
        <h2 class="text-3xl font-bold mb-8">Blogs</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
                posts.map((post) => (
                    <a
                        href={`/blog/${post.id}/`}
                        class="block bg-white dark:bg-accent p-5 shadow-md hover:shadow-lg transition-shadow"
                    >
                        <h3 class="text-xl font-bold mb-2">
                            {post.data.title}
                        </h3>
                        <p class="dark:text-gray-300 mb-4">
                            {post.data.description}
                        </p>
                        <FormattedDate date={post.data.pubDate} />
                    </a>
                ))
            }
        </div>
    </div>
</Layout>
